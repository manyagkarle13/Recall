# Django Settings
SECRET_KEY=django-insecure-recall-super-secret-key-change-in-prod
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Settings (PostgreSQL with pgvector)
DB_NAME=recall_db
DB_USER=recall_user
DB_PASSWORD=recall_password
DB_HOST=localhost
DB_PORT=5432

# Embedding Model Configuration
# Uses pretrained base model by default.
# After Phase 3 fine-tuning, change to: ../ml/checkpoints/recall-finetuned-v1
EMBEDDING_MODEL_NAME_OR_PATH=all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu
